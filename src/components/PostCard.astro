---
import { urlForImage } from "../lib/url-for-image";

const { post } = Astro.props;

const mobileUrl  = urlForImage(post.heroBlock.image).width(385).height(500).auto("format").url();
const tabletUrl  = urlForImage(post.heroBlock.image).width(385).height(534).auto("format").url();
const desktopUrl = urlForImage(post.heroBlock.image).width(410).height(531).auto("format").url();
---

<div class="post-card">
   <a href={`/post/${post.slug.current}`}>
    <picture>
      <source media="(min-width: 1728px)" srcset={desktopUrl} />
      <source media="(min-width: 744px)"  srcset={tabletUrl} />
      <img
        src={mobileUrl}
        alt={post.heroBlock?.title}
        class="card-img"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
  </a>
  <div class="post-content">
    <h3 class="post-category">{post.categoryTitle}</h3>
    <a href={`/post/${post.slug.current}`} class="post-title">
      <h2>{post.heroBlock.title}</h2>
    </a>
      <a href={`/post/${post.slug.current}`} class="post-link">
        <img src="assets/arrow-up-right.svg" alt="Read more"/>
      </a>
  </div>
</div>

<style scoped>
  .post-card {
    position: relative;
    border-radius: 0.125rem;
  }

  .post-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    backdrop-filter: blur(5.8px);
    -webkit-backdrop-filter: blur(5.8px);
    border: 1px solid rgba(185, 185, 185, 0.26);
    /* box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(83, 83, 83, 0.5),
      inset 0 -1px 0 rgba(83, 83, 83, 0.5),
      inset 0 0 6px 3px rgba(83, 83, 83, 0.5); */
    width: 100%;
    padding: 0.6rem 0.6rem 0.4rem 0.6rem;
    background-color: rgba(15, 15, 15, 0.5);
    color: white;
    border-bottom-left-radius: 0.125rem;
    border-bottom-right-radius: 0.125rem;
  }

  .post-category {
    font-size: 0.75rem;
    margin: 0;
    line-height: 1;
  }

  .card-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    aspect-ratio: 364 / 500; /* mobile baseline */
  }

  .post-title {
    width: 87%;
    font-size: 1rem;
    font-weight: 500;
    display: inline-block;
    margin: 0.5rem 0 0 0;
  }

  .post-title h2 {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    height: 2.4em;       /* height, not min-height */
    overflow: hidden;    /* clips anything past 2 lines */
    margin: 0;           /* clear h2 default browser margin */
    display: flex;
    align-items: center;
  }

  .post-link {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 1.2rem;
    height: 1.2rem;
  }

  .post-link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 400px) {
    .post-title {
      width: 80%;
    }
  }

  @media (min-width: 744px) {
    .card-img {
      aspect-ratio: 385 / 534;
    }
  }

  @media (min-width: 1728px) {
    .card-img {
      aspect-ratio: 410 / 531;
    }
  }
</style>