---
import type { GetStaticPaths } from 'astro'
import MainLayout from '../../layouts/MainLayout.astro'
import { sanityClient } from '../../lib/sanity.ts'
import { urlForImage } from '../../lib/url-for-image.ts'
import BlogHero from '../../components/BlogHero.vue'
import { renderPortableText } from '../../lib/portable-text.ts'
import { renderImageBlock } from '../../lib/portable-image.ts'
import { estimateReadingTime } from '../../lib/reading-time.ts'

// ─── Site Constant ─────────────────────────────────────────────────────────────
// Keep in sync with MainLayout.astro and index.astro.
// Future improvement: centralise in src/config/site.ts
const SITE_URL = "https://blog.austincaron.com";

// ─── Static Paths ──────────────────────────────────────────────────────────────
// Fetches only the slug field needed for path generation — keeps the build
// fast by not pulling full post data at this stage.
export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`
    *[_type == "post"] {
      "params": { "postSlug": slug.current }
    }
  `)
  return posts.map((post: any) => ({ params: post.params }))
}

const { postSlug } = Astro.params

// ─── Post Data ─────────────────────────────────────────────────────────────────
// NEW: _createdAt and _updatedAt are Sanity system fields — always present
// on every document, no schema changes required.
//
//   _createdAt → fallback for datePublished when heroBlock.publishedDate is unset
//   _updatedAt → drives dateModified + article:modified_time Open Graph tag
//
// dateModified is used by Google Discover's freshness algorithm to decide
// whether updated content should be re-surfaced to new audiences.
//
// NEW: seo.noIndex is fetched so post pages can suppress indexing from Sanity.
const post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
    _id,
    _createdAt,
    _updatedAt,
    slug,
    "heroBlock": pageBlocks[_type == "heroBlock"][0],
    pageBlocks[] {
      _type,
      _key,
      ...,
      _type == "textBlock" => { content },
      _type == "imageBlock" => { image, caption, altText }
    },
    "categoryTitle": category->title,
    "categorySlug": category->slug.current,
    seo { metaTitle, metaDescription, ogImage, noIndex }
  }
`, { slug: postSlug })

// ─── Meta Values ───────────────────────────────────────────────────────────────
const metaTitle       = post.seo?.metaTitle       || post.heroBlock?.title
const metaDescription = post.seo?.metaDescription || post.heroBlock?.subtitle
const ogImage = post.seo?.ogImage
  ? urlForImage(post.seo.ogImage).width(1200).height(630).url()
  : urlForImage(post.heroBlock.image).width(1200).height(630).url()

// FIXED: was hardcoded to "austincaron.com" — now uses SITE_URL constant.
const canonicalUrl = `${SITE_URL}/post/${post.slug.current}`

// heroBlock.publishedDate is the author-controlled display date.
// _createdAt is the Sanity system fallback — ensures this field is never empty.
const publishedTime = post.heroBlock?.publishedDate ?? post._createdAt
const modifiedTime  = post._updatedAt

// ─── Reading Time ──────────────────────────────────────────────────────────────
// Computed at build time from pageBlocks. Result is used in:
//   1. The post-meta bar UI (improves dwell time → indirect ranking signal)
//   2. JSON-LD timeRequired field (ISO 8601 duration)
const { minutes: readingMinutes, iso: readingTimeIso } = estimateReadingTime(post.pageBlocks)

// ─── Structured Data ───────────────────────────────────────────────────────────

// BlogPosting Schema
// ─────────────────
// This was missing entirely from the previous implementation — the single
// largest gap in the site's structured data. Google requires headline, image,
// datePublished, and author to make a page eligible for article rich results.
//
// The @id values use fragment identifiers (#article, #author) to create
// cross-document references. The author @id matches the Person entity
// declared in MainLayout.astro's WebSite schema, so Google can confirm
// this post belongs to Austin Caron without re-parsing the Person definition.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#article`,
  headline: metaTitle,
  description: metaDescription,
  image: {
    "@type": "ImageObject",
    url: ogImage,
    width: 1200,
    height: 630,
  },
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    "@type": "Person",
    // Cross-references the Person entity from MainLayout's WebSite schema.
    // Google resolves this @id to Austin Caron's full entity definition,
    // building cumulative E-E-A-T across all posts.
    "@id": `${SITE_URL}/#author`,
    name: "Austin Caron",
    url: SITE_URL,
  },
  // For a self-published blog, publisher === author. Using Person is correct.
  // Using Organization would be inaccurate and could create entity confusion.
  publisher: {
    "@type": "Person",
    "@id": `${SITE_URL}/#author`,
    name: "Austin Caron",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  url: canonicalUrl,
  ...(post.categoryTitle && { articleSection: post.categoryTitle }),
  wordCount: post.pageBlocks
    ? post.pageBlocks.reduce((acc: number, block: any) => {
        if (block._type === "textBlock" && block.content) {
          return acc + block.content.reduce((a: number, b: any) =>
            a + (b.children?.reduce((c: number, d: any) =>
              c + (d.text?.trim().split(/\s+/).filter(Boolean).length ?? 0), 0) ?? 0), 0)
        }
        return acc
      }, 0)
    : 0,
  timeRequired: readingTimeIso,
  // isPartOf links this post back to the Blog entity on the homepage,
  // completing the entity hierarchy: WebSite → Blog → BlogPosting.
  isPartOf: {
    "@type": "Blog",
    "@id": `${SITE_URL}/#blog`,
    name: "Pixels & Pull Requests",
    url: SITE_URL,
  },
}

// BreadcrumbList Schema
// ─────────────────────
// Breadcrumb trails appear in Google SERPs as path context below the URL:
//   blog.austincaron.com › Video Games › Post Title
//
// Studies consistently show 15–30% CTR improvement when breadcrumbs appear.
// The position values must be sequential integers starting at 1.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: metaTitle,
      item: canonicalUrl,
    },
  ],
}

// Human-readable date for display in the post-meta bar.
const formattedDate = publishedTime
  ? new Date(publishedTime).toLocaleDateString("en-CA", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null
---

<MainLayout
  title={metaTitle}
  description={metaDescription}
  ogTitle={metaTitle}
  ogDescription={metaDescription}
  ogImage={ogImage}
  ogUrl={canonicalUrl}
  canonicalUrl={canonicalUrl}
  ogType="article"
  articlePublishedTime={publishedTime}
  articleModifiedTime={modifiedTime}
  articleSection={post.categoryTitle}
  noIndex={post.seo?.noIndex ?? false}
>
  <!--
    Inject article-specific schemas into <head> via the named slot.
    Using the head slot (rather than placing scripts in the body) ensures
    structured data is in the document head, which is Google's preferred
    location (though body placement is also valid and was used previously).
  -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="max-w-[1300px] mx-auto px-3 flex flex-col gap-[29px] sm:gap-[45px] mb-10">
    <BlogHero heroBlock={post.heroBlock} readingMinutes={readingMinutes} />

    {post.pageBlocks.map((block: any) => (
      <>
        {block._type === 'textBlock' && block.content && (
          <div class="max-w-none content content-text flex flex-col gap-[8px]" set:html={renderPortableText(block.content)} />
        )}
        {block._type === 'imageBlock' && block.image && (
          <div set:html={renderImageBlock(block)} />
        )}
      </>
    ))}
  </article>
</MainLayout>

<style>
  /* Post meta bar */
  .post-meta {
    color: var(--color-text-secondary, #888);
    padding-top: 4px;
  }

  .post-meta__category {
    font-weight: 600;
    color: var(--color-accent, currentColor);
    text-decoration: none;
  }

  .post-meta__category:hover {
    text-decoration: underline;
  }

  .post-meta__date {
    color: var(--color-text-secondary, #888);
  }

  /* Content block styles — unchanged from original */
  .content :global(h2) {
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .content :global(h2:not(:first-child)) {
    margin-top: 13px; /* 39px block gap - 8px flex gap already there */
  }

  @media (min-width: 640px) {
    .content :global(h2:not(:first-child)) {
      margin-top: 27px; /* 45px block gap - 8px flex gap already there */
    }

    .content :global(h2) {
      font-size: 2.1rem;
      width: 93%;
      margin-left: auto;
      margin-right: auto;
    }

    .content :global(p) {
      font-size: 1.1rem;
      width: 93%;
      margin: 0 auto
    }
  }
</style>