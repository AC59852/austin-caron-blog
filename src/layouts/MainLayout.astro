---
import NavButton from "../components/NavButton.vue";
import NavMenu from "../components/NavMenu.vue";
import "../styles/global.css";

// ─── Site-Wide Constants ───────────────────────────────────────────────────────
// IMPORTANT: Confirm SITE_URL matches your exact live domain.
// A mismatch between this and your actual domain causes every canonical tag
// and every og:url on the site to point at the wrong place.
// Future improvement: move these to src/config/site.ts and import from there
// to prevent drift across files.
const SITE_URL   = "https://blog.austincaron.com";
const SITE_NAME  = "Pixels & Pull Requests";
const AUTHOR_NAME = "Austin Caron";
// ↓ Fill in your Twitter/X handle. If you don't have one yet, set to "".
const TWITTER_HANDLE = "@AustinCaron";

// ─── Props ─────────────────────────────────────────────────────────────────────
interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  canonicalUrl?: string;
  /**
   * "article" for individual blog posts, "website" for all other pages.
   * og:type changes how Facebook, LinkedIn, and Google Discover classify
   * and surface the page — "article" unlocks richer share cards and Discover.
   */
  ogType?: "website" | "article";
  /**
   * ISO 8601 datetime string (e.g. "2025-06-01T12:00:00Z").
   * Only rendered when ogType === "article".
   * Drives article:published_time, which is a primary Google Discover freshness input.
   */
  articlePublishedTime?: string;
  /**
   * ISO 8601 datetime string. Uses Sanity's _updatedAt system field.
   * Only rendered when ogType === "article".
   */
  articleModifiedTime?: string;
  /**
   * Maps to the post's category title. Feeds article:section, which Facebook
   * uses for topic classification and aggregated reach.
   * Only rendered when ogType === "article".
   */
  articleSection?: string;
  /**
   * Set to true to emit "noindex, nofollow". Use on draft posts, thin
   * content, or any page you don't want in Google's index.
   * Controlled via the new seo.noIndex field in Sanity.
   */
  noIndex?: boolean;
}

const {
  title       = `${SITE_NAME} — ${AUTHOR_NAME}`,
  description = "Web development, video games, technology, pop culture, and history — written with personality by Austin Caron.",
  ogTitle     = title,
  ogDescription = description,
  ogImage     = `${SITE_URL}/og-image.png`,
  ogUrl       = SITE_URL,
  canonicalUrl = ogUrl,
  ogType      = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  noIndex     = false,
} = Astro.props as Props;

// ─── WebSite + Person JSON-LD ──────────────────────────────────────────────────
// Placed in the layout so every page carries the same foundational entity graph.
//
// WHY THIS MATTERS:
// Google's Knowledge Graph builds an "entity" for your site and for you as an
// author. The WebSite @id creates a stable anchor that per-page BlogPosting
// schemas reference, telling Google all these articles belong to one coherent
// publication.
//
// The Person schema's sameAs array is the primary E-E-A-T (Experience,
// Expertise, Authoritativeness, Trustworthiness) mechanism for individual
// bloggers. Google cross-references every URL you list here to confirm you are
// who you say you are. More sameAs links = higher entity confidence.
//
// ACTION: Fill in sameAs with every social/professional profile you own.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: SITE_URL,
  description: "Web development, video games, technology, pop culture, and history — written with personality by Austin Caron.",
  inLanguage: "en-CA",
  author: {
    "@type": "Person",
    "@id": `${SITE_URL}/#author`,
    name: AUTHOR_NAME,
    url: SITE_URL,
    jobTitle: "Web Developer",
    knowsAbout: [
      "Web Development",
      "JavaScript",
      "Vue.js",
      "React",
      "Video Games",
      "Technology",
      "Pop Culture",
    ],
    // ↓ Uncomment and fill in every URL that belongs to you.
    // Each one strengthens Google's confidence that "Austin Caron" the blog
    // author is the same person as your GitHub, YouTube, and LinkedIn accounts.
    sameAs: [
      "https://github.com/AC59852",
      "https://twitter.com/austincaron_",
      "https://www.linkedin.com/in/austincaron/",
      "https://www.youtube.com/@AustinCaron",
    ],
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- ─── Favicons ─────────────────────────────────────────────────────────
    -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Pixels & Pull Requests" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#86B4FA" />

    <!-- ─── Primary Meta ──────────────────────────────────────────────────────
    -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    {noIndex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }

    <!-- ─── Canonical ────────────────────────────────────────────────────────
    -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- ─── Open Graph ───────────────────────────────────────────────────────
    -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === "article" && (
      <meta property="article:author" content={AUTHOR_NAME} />
    )}
    {ogType === "article" && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <!-- ─── Twitter / X ───────────────────────────────────────────────────────
    -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogTitle} />

    <!-- ─── Fonts ─────────────────────────────────────────────────────────────
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- ─── Structured Data: WebSite + Person ─────────────────────────────────
    -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col m-0 p-0">
    <header class="header">
      <nav class="flex items-center justify-between p-4 max-w-[90%] mx-auto">
        <a href="/" class="nav-home" aria-label="Pixels & Pull Requests — go to homepage">P&PR</a>
        <NavButton client:load />
        <NavMenu client:load />
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  .nav-home {
    font-size: 22px;
    font-weight: bold;
    font-family: var(--font-sans);
    color: var(--color-text-primary);
  }

  @media screen and (min-width: 640px) {
    .nav-home {
      font-size: 32px;
    }
  }
</style>